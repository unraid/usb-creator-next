# Generated by src/cmake/UnraidBranding.cmake at configure time -- do not edit.
#
# UNRAID: shell-sourceable product identity, so packaging scripts read the same
# values the build used instead of carrying their own copies. create-appimage.sh
# previously re-declared the exe name, desktop id and AppImage name with its own
# hardcoded defaults; when those drifted from CMake the build still went green
# and produced an AppImage whose AppRun exec'd a path that did not exist.
#
# Single-quoted because IMAGER_APP_NAME contains spaces.
#
# See PORTING.md, "Branding layer".

IMAGER_APP_NAME='@IMAGER_APP_NAME@'
IMAGER_EXE_NAME='@IMAGER_EXE_NAME@'
IMAGER_BUNDLE_ID='@IMAGER_BUNDLE_ID@'
IMAGER_VENDOR='@IMAGER_VENDOR@'
IMAGER_APPIMAGE_NAME='@IMAGER_APPIMAGE_NAME@'
IMAGER_DESKTOP_FILE='@IMAGER_DESKTOP_FILE@'
